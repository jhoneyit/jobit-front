# ─── LLM ──────────────────────────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ─── DB (2026-08-04: jobit 서버와 하나의 DB 를 공유한다) ──────────────────
# `jobit/compose.yaml` 이 띄우는 Postgres 다. 그쪽 Docker 가 떠 있어야 한다.
#
# **스키마는 jobit 의 Flyway 가 소유한다.** 이 레포의 drizzle-kit 은 마이그레이션에서
# 손을 뗐다 — 컬럼을 바꾸려면 jobit/src/main/resources/db/migration/ 에 추가한다.
# 자세한 내용은 src/lib/db/schema.ts 상단 주석 참고.
DATABASE_URL=postgresql://jobit:jobit@localhost:5432/jobit

# ─── 백엔드 (jobit / Spring) ──────────────────────────────────────────────
# 도메인 로직·LLM 호출은 이 서버가 한다. `cd ../jobit && ./gradlew bootRun`
JOBIT_API_URL=http://localhost:8080

# ─── 인증 (스펙 §2: GitHub OAuth) ─────────────────────────────────────────
# 1) https://github.com/settings/developers → New OAuth App
# 2) Authorization callback URL:
#      개발  http://localhost:3000/api/auth/callback/github
#      운영  https://<도메인>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# 세션 쿠키 서명 키. `openssl rand -base64 32` 로 생성한다.
AUTH_SECRET=

# 운영 배포에서만 필요 (Vercel 은 자동 주입되므로 보통 비워 둔다).
# 프록시 뒤에 있으면 실제 외부 URL 을 넣는다.
# AUTH_URL=https://<도메인>

# ─── 관리자 콘솔 (/admin) ─────────────────────────────────────────────────
# 비워 두면 admin / admin 으로 로그인된다 — 로컬 확인용 기본값이다.
# **운영에서는 ADMIN_PASSWORD 를 설정하지 않으면 /admin 이 아예 열리지 않는다.**
# 서비스 사용자 계정과는 완전히 별개이며, 세션 쿠키 서명에 AUTH_SECRET 을 쓴다.
# ADMIN_USER=admin
# ADMIN_PASSWORD=

# ─── 비용 통제 (스펙 §6) ──────────────────────────────────────────────────
# 호출 제한은 `jobit` 이 건다 (LlmGuard — 소유자별 시간당 한도 + 전역 일일 비용 상한).
# 설정은 그쪽 application.properties 의 jobit.llm.* 를 본다.

# ─── 메일 (비밀번호 재설정) ───────────────────────────────────────────────
# 비워 두면 재설정 링크가 서버 콘솔에만 출력된다 — 개발 중에는 이걸로 충분하다.
# 운영에서는 반드시 채운다. 없으면 사용자가 재설정 메일을 받지 못한다.
#   1) https://resend.com/api-keys 에서 키 발급
#   2) 보내는 주소의 도메인을 Resend 에 등록·인증
# RESEND_API_KEY=re_...
# MAIL_FROM=jobit <no-reply@your-domain.com>

# 재설정 링크에 쓰일 기준 URL. 비우면 AUTH_URL → Vercel URL → localhost:3000 순으로 정해진다.
# NEXT_PUBLIC_APP_URL=https://your-domain.com
